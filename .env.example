# Pública. Dominio canónico sin ruta ni barra final; usar el mismo valor en previews.
NEXT_PUBLIC_SITE_URL=https://www.example.test

# Privada. Clave de Resend; configurar como Sensitive en Vercel.
RESEND_API_KEY=re_example_key

# Privada. Buzón que recibe las consultas del formulario.
CONTACT_EMAIL=contact@example.test

# Privada. Remitente con un dominio verificado en Resend.
CONTACT_FROM_EMAIL="Fuentivo <contact@example.test>"
